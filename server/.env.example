# Required
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-flash-latest
# Tried in order if the primary model is overloaded / over quota
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-lite-latest
# Optional: enables the "ground station" card (get a free token at https://aqicn.org/data-platform/token/)
WAQI_TOKEN=
# Frontend origin allowed by CORS (any *.vercel.app is also allowed)
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
