# Required — free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Tried in order if the primary model is rate-limited / unavailable
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b
# Optional: enables the "ground station" card (get a free token at https://aqicn.org/data-platform/token/)
WAQI_TOKEN=
# Frontend origin allowed by CORS (any *.vercel.app is also allowed)
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
